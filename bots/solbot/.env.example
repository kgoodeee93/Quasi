# Dry run (the default) needs none of these except, for Telegram trade pings, the last two.
# Live trading needs SOLBOT_LIVE=yes plus WALLET_PRIVATE_KEY and RPC_URL.

# SOLBOT_LIVE=yes            # <- the only switch to real trading. Leave unset for dry run.
WALLET_PRIVATE_KEY=          # base58 key of a BURNER wallet funded with what you can lose
RPC_URL=                     # your own RPC (Helius / Triton / QuickNode); the public one drops trades
JUPITER_API_KEY=             # optional (developers.jup.ag/portal); keyless works at low volume

# Entries: "feed" (alerts from the sniper feed's database) or "solanatracker" (scan trending).
ENTRY_SOURCE=feed
FEED_DB=../../alerts/sniper-feed/feed.db
SOLANA_TRACKER_API_KEY=      # needed only for ENTRY_SOURCE=solanatracker (Advanced plan or above)

# Trade pings. Use a private chat, NOT the subscribers' alert channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
