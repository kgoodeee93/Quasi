# Copy to .env and fill in. All keys are optional; the dashboard degrades gracefully.

# CoinGecko: free "Demo" key from https://www.coingecko.com/en/api (raises rate limits).
COINGECKO_API_KEY=
# "demo" (free) or "pro" (paid plan, uses pro-api.coingecko.com)
COINGECKO_PLAN=demo

# Alchemy: free key from https://dashboard.alchemy.com. Optional: without it, ERC-20s are read
# keylessly via Blockscout or a Multicall3 scan (slower, rate-limited public endpoints).
ALCHEMY_API_KEY=

# Optional overrides
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BITCOIN_API_URL=https://mempool.space/api
VS_CURRENCY=usd
WALLETS_FILE=wallets.json
# Seconds to cache a computed portfolio before re-fetching everything
CACHE_TTL=60

# Put the whole site behind a password (HTTP Basic auth, any username). deploy.sh sets this for you.
DASHBOARD_PASSWORD=
