# Copy to .env (git-ignored). Real environment variables win over this file.

# Claude API key from https://console.anthropic.com (or run `ant auth login` instead).
ANTHROPIC_API_KEY=

# Optional overrides
# QUASI_MODEL=claude-opus-5-5
# QUASI_EFFORT=medium            # low | medium | high | xhigh | max
# QUASI_TIMEZONE=America/New_York  # default: your Google Calendar's timezone
# QUASI_HOME=~/.config/quasi       # where the OAuth client, token and audit log live
# GOOGLE_CLIENT_SECRET_FILE=~/.config/quasi/google_client_secret.json
